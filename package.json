{
  "name": "soothsayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @soothsayer/api dev",
    "api": "tsx packages/api/src/server.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "sooth": "tsx packages/cli/src/index.ts",
    "demo:canvas": "tsx packages/cli/src/index.ts thesis \"For NVDA, buy momentum when SMA20 crosses above SMA50 and RSI is below 70; ask the oracle.\" --symbol NVDA --iching --out examples/nvda_momentum.sooth.json",
    "demo:eval": "tsx packages/cli/src/index.ts eval examples/nvda_momentum.sooth.json --out examples/nvda_momentum.evaluated.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.8.4",
    "commander": "^14.0.2",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
