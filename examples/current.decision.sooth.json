      },
      "to": {
        "node": "score",
        "port": "signal"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "score",
        "port": "score"
      },
      "to": {
        "node": "levels",
        "port": "score"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "score",
        "port": "score"
